{
  "name": "mdflow",
  "version": "5.0.0",
  "license": "MIT",
  "module": "src/index.ts",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/johnlindquist/mdflow.git"
  },
  "bin": {
    "mdflow": "./bin/mdflow.mjs",
    "md": "./src/index.ts"
  },
  "files": [
    "bin",
    "src",
    "!src/**/*.test.ts",
    "!src/__snapshots__",
    "!src/test-utils.ts",
    "assets",
    "skills",
    "docs/public-api.md",
    "docs/evolve.md",
    "README.md"
  ],
  "scripts": {
    "test": "bun test --bail=1",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:trust": "bun test src/trust-boundaries.test.ts src/evolution-store-lock.test.ts src/evolve.test.ts src/eval-audit-hardening.test.ts src/hooks-integration.test.ts",
    "security:check": "bun audit --prod && bun audit --audit-level=high && cd site && bun audit",
    "package:check": "bun run scripts/package-smoke.ts",
    "verify": "bun run typecheck && bun test && bun run facts:check && bun run guidance:check && bun run package:check",
    "postversion": "bun run facts && bun run guidance",
    "md": "bun run src/index.ts",
    "bundle": "bun run scripts/bundle.ts -o",
    "bundle:core": "bun run scripts/bundle.ts --core -o",
    "bundle:stdout": "bun run scripts/bundle.ts",
    "facts": "bun run scripts/generate-facts.ts",
    "facts:check": "bun run scripts/generate-facts.ts --check",
    "guidance": "bun run scripts/generate-agent-guidance.ts",
    "guidance:check": "bun run scripts/generate-agent-guidance.ts --check",
    "verify:codex-isolation": "bun test src/adapters/codex-hooks-home.test.ts src/isolation.test.ts src/command.test.ts src/cli-runner.test.ts src/hooks-integration.test.ts src/isolation-integration.test.ts && bun run typecheck",
    "probe:codex-isolation": "bun run scripts/probe-codex-isolation.ts"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.2",
    "@semantic-release/npm": "^13.1.2",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@types/bun": "latest",
    "@types/js-yaml": "^4.0.9",
    "@types/mdast": "^4.0.4",
    "fast-check": "^4.4.0",
    "semantic-release": "^25.0.2"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@inquirer/core": "^10.1.11",
    "@inquirer/prompts": "^8.0.2",
    "gpt-tokenizer": "^3.4.0",
    "ignore": "^7.0.5",
    "js-yaml": "^4.3.2",
    "liquidjs": "^10.30.1",
    "marked": "^17.0.1",
    "marked-terminal": "^7.3.0",
    "pino": "^10.1.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "zod": "^4.6.7"
  }
}
