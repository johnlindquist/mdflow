{
  "name": "mdflow.dev",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "portless run --name mdflow vite",
    "dev:raw": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test ./components/workbench-demo/model.test.ts ./components/workbench-demo/screens.test.ts ./middleware.test.ts ./components/play-fx/playground.test.ts",
    "build": "vite build && node scripts/prerender.mjs && node scripts/build-content.mjs && node scripts/build-agent-resources.mjs",
    "verify": "bun run test && bun run typecheck && bun run build",
    "preview": "vite preview",
    "og-image": "node scripts/generate-og-image.mjs"
  },
  "dependencies": {
    "@vercel/functions": "^3.10.6",
    "@wterm/dom": "0.3.0",
    "@wterm/react": "0.3.0",
    "framer-motion": "^12.23.25",
    "lucide-react": "^0.556.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.21",
    "marked": "^18.0.5",
    "postcss": "^8.5.6",
    "puppeteer": "^25.16.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.2",
    "vite": "^6.4.5"
  }
}
